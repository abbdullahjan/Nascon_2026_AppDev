# ============================================================
# Root .gitignore — covers backend (Node.js) + Flutter
# ============================================================

# ----- Node.js / Backend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example

# ----- Flutter / Dart -----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
/coverage/
*.class

# ----- IDE / Editor -----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Docker -----
*.tar        # large image archives — keep outside the repo
docker-compose.override.yml

# ----- Logs -----
*.log
logs/
