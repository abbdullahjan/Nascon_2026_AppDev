# ─── NaSCon '26 — Environment Variables ──────────────────────────────────────
# Copy to .env and fill in your values.
# NEVER commit your real .env to GitHub.

# Competition salt — printed on your team slip. Injected into the container.
# Set this on your host before running: export DAY1_SALT=your-real-salt
DAY1_SALT=your-team-salt-here

# JWT signing secret (change for production)
JWT_SECRET=change-this-to-a-long-random-secret

# PostgreSQL (these match the docker-compose defaults — change if needed)
POSTGRES_DB=nascon_db
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_pass

# These are constructed from the above inside docker-compose.yml
DATABASE_URL=postgresql://nascon:nascon_pass@postgres:5432/nascon_db
REDIS_URL=redis://redis:6379
