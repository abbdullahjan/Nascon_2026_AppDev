# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to GitHub.
# The real DAY1_SALT is printed on your team slip — never hard-code it.

# Competition salt (injected by docker-compose from the host environment)
DAY1_SALT=your-team-salt-here

# Server
PORT=8080
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://nascon:nascon_pass@postgres:5432/nascon_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nascon_db
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_pass

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=2h

# MinIO (object store for PDF receipts)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts
