# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to GitHub.
# DAY1_SALT and DAY2_SALT are printed on your team slip — never hard-code them.

# Competition salts (injected by docker-compose from the host environment)
DAY1_SALT=your-day1-salt-here
DAY2_SALT=your-day2-salt-here

# Server
PORT=8080
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://nascon:nascon_pass@postgres:5432/nascon_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nascon_db
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_pass

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=2h

# RustFS (S3-compatible object storage — replaces MinIO)
# Access via AWS S3 SDK configured with these env vars
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=nascon
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1

# MediaMTX media server (fixed ports per spec 6.1 — do not change)
MEDIA_HOST=localhost
MEDIA_RTMP_PORT=1935
MEDIA_HLS_PORT=8888
MEDIA_WEBRTC_PORT=8889
